{
  "bsonType": "object",
  "description": "club_members（社团成员）：复合索引 (club_id, user_id)；成员移除后再次录取采用原记录复活（removed → active）",
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "成员记录 ID"
    },
    "club_id": {
      "bsonType": "string",
      "description": "社团 ID（复合索引）"
    },
    "user_id": {
      "bsonType": "string",
      "description": "用户 ID（复合索引）"
    },
    "role": {
      "bsonType": "string",
      "enum": ["president", "officer", "member"],
      "description": "角色：president 社长 / officer 干部 / member 成员"
    },
    "joined_at": {
      "bsonType": ["date", "timestamp"],
      "description": "入团时间"
    },
    "status": {
      "bsonType": "string",
      "enum": ["active", "removed"],
      "description": "状态：active / removed"
    },
    "deleted": {
      "bsonType": "int",
      "description": "软删除标志 0/1"
    }
  },
  "required": ["club_id", "user_id", "role", "status", "joined_at", "deleted"]
}