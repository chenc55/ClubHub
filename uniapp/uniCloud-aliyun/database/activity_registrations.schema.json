{
  "bsonType": "object",
  "description": "activity_registrations（活动报名）：复合索引 (activity_id, user_id)；status 含 waitlist 候补（转正按 signup_at 升序）",
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "报名记录 ID"
    },
    "activity_id": {
      "bsonType": "string",
      "description": "活动 ID（复合索引）"
    },
    "user_id": {
      "bsonType": "string",
      "description": "用户 ID（复合索引）"
    },
    "status": {
      "bsonType": "string",
      "enum": ["pending", "approved", "waitlist", "rejected", "cancelled"],
      "description": "状态：pending / approved / waitlist / rejected / cancelled"
    },
    "remark": {
      "bsonType": "string",
      "description": "备注"
    },
    "checked_in": {
      "bsonType": "bool",
      "description": "是否已签到（冗余字段）"
    },
    "attendance": {
      "bsonType": "string",
      "enum": ["present", "absent"],
      "description": "参加判定（P1-15 新增）：present 已到 / absent 缺席；未判定 = 不填该字段"
    },
    "signup_at": {
      "bsonType": ["date", "timestamp"],
      "description": "报名时间（候补转正排序依据）"
    },
    "deleted": {
      "bsonType": "int",
      "description": "软删除标志 0/1"
    }
  },
  "required": ["activity_id", "user_id", "status", "signup_at", "deleted"]
}